# Copy this file to .env and fill it in.

# How many days back to look for job emails.
DAYS=30

# Google Sheet to write to (the long ID in the sheet's URL).
# Leave empty to write applications.csv and emails.csv instead.
SHEET_ID=

# Optional: a Claude API key makes company/role/status detection more accurate.
# Needs Python 3.10+ and `pip install anthropic`. Leave empty to use built-in rules.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional: replace the built-in Gmail search entirely.
# JOB_QUERY=

# Optional: track the cold emails you send (e.g. with the Mailer). A Gmail search
# that finds them in your Sent mail; leave empty to turn outreach tracking off.
# OUTREACH_QUERY=in:sent newer_than:90d subject:"Software / ML Engineer interested in"
# Days without an answer before an email shows as "Follow-up due".
# FOLLOW_UP_DAYS=7

# Optional: where the "what's pending" reminder goes (scripts/remind_mac.sh).
# Telegram (a normal phone notification): the token @BotFather gives you, and your chat ID.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Or an iMessage from this Mac's Messages app. If the Mac's iMessage uses this same
# number, it lands in your thread with yourself, usually without an alert.
# REMINDER_PHONE=+14805551234

# OAuth files (downloaded from Google Cloud / created on first login).
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Dashboard heading. Defaults to "Current Search: Q<quarter> <year>".
# SEARCH_TITLE=Current Search: Q4 Senior IC & Lead Roles

# Optional: what the dashboard calls you in the greeting.
# FRIDAY_NAME=
