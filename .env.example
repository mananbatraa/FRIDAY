# FRIDAY settings. ./setup.sh copies this to .env and fills in most of it for you.
# Anything left empty or commented out is simply switched off.

# ---------------------------------------------------------------- you

# What FRIDAY calls you ("Good morning, <name>").
FRIDAY_NAME=

# ---------------------------------------------------------------- Gmail

# How many days back to look for job emails.
DAYS=30

# Google Cloud app file (see the README) and where the main login is saved.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# More Gmail accounts to read, comma-separated, e.g. a university address.
# Each logs in once and is saved as token_<name>.json. To log one in through a
# different Google Cloud app, put that app's file here as credentials_<name>.json.
# ALSO_READ_GMAIL=you@university.edu

# Optional: replace the built-in job-email search entirely.
# JOB_QUERY=

# ---------------------------------------------------------------- where the tracker lives

# Google Sheet ID (from docs.google.com/spreadsheets/d/<THIS>/edit). Empty: CSV files.
SHEET_ID=

# Optional: Claude reads each email instead of the built-in rules (Python 3.10+, paid API).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- cold-email outreach

# A Gmail search that finds the cold emails you sent; empty turns tracking off.
# OUTREACH_QUERY=in:sent newer_than:90d (subject:"MS CS student interested in" OR subject:"roles at")
# Days with no answer before an email shows as "Follow-up due".
# FOLLOW_UP_DAYS=7

# ---------------------------------------------------------------- your day (report and alerts)

# Canvas: Calendar > "Calendar Feed" (bottom right). Treat it like a password.
# CANVAS_ICS_URL=https://canvas.example.edu/feeds/calendars/user_XXXX.ics

# Calendars, comma-separated. Google Calendar > Settings > your calendar >
# Integrate calendar > "Secret address in iCal format". Treat them like passwords.
# CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/you%40gmail.com/private-XXXX/basic.ics

# The stock-research app, for its daily summary in the morning message.
# STOCKS_DIR=/Users/you/Projects/stock-research

# ---------------------------------------------------------------- phone notifications

# ntfy (recommended, free): install the "ntfy" app, subscribe to this topic.
# Pick something long and random; anyone who knows it can read your alerts.
# NTFY_TOPIC=friday-yourname-1a2b3c4d5e6f

# Reminder texts go to the first of these that's set up:
# WhatsApp through CallMeBot (free; see the README):
# WHATSAPP_PHONE=+14805551234
# CALLMEBOT_APIKEY=
# Telegram bot:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# (then ntfy, if NTFY_TOPIC is set)
# iMessage from this Mac. To your own number it arrives without an alert.
# REMINDER_PHONE=+14805551234

# ---------------------------------------------------------------- dashboard

# Heading on the dashboard. Defaults to "Current Search: Q<quarter> <year>".
# SEARCH_TITLE=Current Search: New Grad 2027
