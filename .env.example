# Copy this file to .env and fill it in.

# Gmail search that finds Tenta AI confirmation emails.
# Update the sender once you've looked at a real Tenta email.
TENTA_QUERY=from:(tenta) newer_than:60d

# Google Sheet to write to (the long ID in the sheet's URL).
# Leave empty to write to applications.csv instead.
SHEET_ID=

# OAuth files (downloaded from Google Cloud / created on first login).
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
